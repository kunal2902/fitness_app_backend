# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Mongo. MONGODB_URI is accepted as an alias if you prefer that spelling.
MONGO_URI=mongodb://127.0.0.1:27017/fitness_app

# Generate real secrets before deploying:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=fitness-app

BCRYPT_ROUNDS=12

# Comma-separated allowed origins, or * for any (development only).
CORS_ORIGINS=*
