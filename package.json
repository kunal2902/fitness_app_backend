{
  "name": "app_backend",
  "version": "1.0.0",
  "description": "Fitness app backend - Phase 1 (auth + onboarding profile)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "selfcheck": "tsx scripts/selfcheck.ts",
    "selfcheck:foods": "tsx scripts/food-pipeline-selfcheck.ts",
    "selfcheck:nutrition": "tsx scripts/nutrition-api-selfcheck.ts",
    "selfcheck:targets": "tsx scripts/nutrition-target-selfcheck.ts",
    "selfcheck:http": "tsx scripts/nutrition-http-selfcheck.ts",
    "selfcheck:tracking": "tsx scripts/tracking-api-selfcheck.ts",
    "selfcheck:training": "tsx scripts/training-catalogue-selfcheck.ts",
    "selfcheck:training-review": "tsx scripts/training-review-selfcheck.ts",
    "verify:catalogue": "tsx scripts/verify-nutrition-catalogue.ts",
    "verify:usda": "tsx scripts/verify-usda-live.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:nutrition": "tsx scripts/nutrition-smoke.ts",
    "smoke:tracking": "tsx scripts/tracking-smoke.ts",
    "smoke:training-catalogue": "tsx scripts/training-catalogue-smoke.ts",
    "smoke:training-discovery": "tsx scripts/training-discovery-smoke.ts",
    "smoke:realtime": "tsx scripts/realtime-smoke.ts",
    "backfill:tracking-thumbnails": "tsx scripts/backfill-route-thumbnails.ts",
    "test": "npm run typecheck && npm run selfcheck && npm run selfcheck:foods && npm run selfcheck:nutrition && npm run selfcheck:targets && npm run selfcheck:http && npm run selfcheck:tracking && npm run selfcheck:training && npm run selfcheck:training-review",
    "seed:training": "tsx scripts/import-training-catalogue.ts",
    "seed:pros": "tsx scripts/seed-professionals.ts",
    "seed:foods": "tsx scripts/import-foods.ts",
    "seed:foods:dry": "tsx scripts/import-foods.ts --ifct data/nutrition/raw/ifct2017-compositions.csv --indb data/nutrition/raw/Anuvaad_INDB_2024.11.xlsx --dry-run",
    "seed:foods:local": "tsx scripts/import-foods.ts --ifct data/nutrition/raw/ifct2017-compositions.csv --indb data/nutrition/raw/Anuvaad_INDB_2024.11.xlsx --local-only",
    "seed:foods:import": "tsx scripts/import-foods.ts --ifct data/nutrition/raw/ifct2017-compositions.csv --indb data/nutrition/raw/Anuvaad_INDB_2024.11.xlsx",
    "review:servings": "tsx scripts/export-serving-review-data.ts",
    "review:training": "tsx scripts/export-training-review.ts",
    "review:training:apply": "tsx scripts/apply-training-review.ts",
    "export:servings": "tsx scripts/export-serving-overrides.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.1.6",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "read-excel-file": "^9.3.10",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
